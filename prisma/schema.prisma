generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  address     String? @db.VarChar(255)
  phone       String? @db.VarChar(20)
  license_key String? @db.VarChar(255)
  orders      Order[]
  users       User[]
  tables      Table[]

  @@map("branches")
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  name_hi    String?    @db.VarChar(150)
  name_gu    String?    @db.VarChar(150)
  sort_order Int        @default(0)
  items      MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           Int         @id @default(autoincrement())
  category_id  Int
  name         String      @db.VarChar(100)
  name_hi      String?     @db.VarChar(150)
  name_gu      String?     @db.VarChar(150)
  description  String?
  desc_hi      String?
  desc_gu      String?
  price        Float
  is_favorite  Boolean     @default(false)
  food_type    String?     @default("veg") @db.VarChar(20)
  short_code   String?     @db.VarChar(10)
  variant_name String?     @db.VarChar(50)
  is_combo     Boolean     @default(false)
  combo_items  String?
  is_available Boolean     @default(true)
  category     Category    @relation(fields: [category_id], references: [id])
  order_items  OrderItem[]

  @@map("menu_items")
}

model Table {
  id                 Int       @id @default(autoincrement())
  branch_id          Int
  name               String    @db.VarChar(20)
  section            String?   @default("Main") @db.VarChar(50)
  seats              Int?      @default(2)
  qr_code            String?   @db.VarChar(255)
  status             String?   @default("vacant") @db.VarChar(20)
  session_start_time DateTime?
  is_active          Boolean   @default(true)
  orders             Order[]
  branch             Branch    @relation(fields: [branch_id], references: [id])

  @@map("tables")
}

model Order {
  id                Int          @id @default(autoincrement())
  branch_id         Int
  table_id          Int?
  type              String       @db.VarChar(20)
  status            String?      @default("new") @db.VarChar(20)
  customer_name     String?      @db.VarChar(100)
  customer_mobile   String?      @db.VarChar(15)
  coupon_code       String?      @db.VarChar(50)
  delivery_address  String?
  landmark          String?      @db.VarChar(100)
  delivery_charge   Float?       @default(0.0)
  discount_reason   String?      @db.VarChar(200)
  discount_type     String?      @db.VarChar(20)
  discount_value    Float?       @default(0.0)
  delivery_staff_id Int?
  created_at        DateTime?    @default(now())
  has_new_items     Boolean?     @default(false)
  created_by        Int?
  covers            Int?         @default(1)
  feedbacks         Feedback[]
  invoices          Invoice[]
  items             OrderItem[]
  branch            Branch       @relation(fields: [branch_id], references: [id])
  creator           User?        @relation("OrderCreator", fields: [created_by], references: [id])
  delivery_staff    User?        @relation("OrderDeliveryStaff", fields: [delivery_staff_id], references: [id])
  table             Table?       @relation(fields: [table_id], references: [id])
  waiter_calls      WaiterCall[]

  @@map("orders")
}

model OrderItem {
  id             Int       @id @default(autoincrement())
  order_id       Int
  menu_item_id   Int
  variant        String?   @db.VarChar(50)
  quantity       Int       @default(1)
  price_at_order Float
  kot_number     Int?      @default(1)
  added_at       DateTime? @default(now())
  menu_item      MenuItem  @relation(fields: [menu_item_id], references: [id])
  order          Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model User {
  id              Int            @id @default(autoincrement())
  mobile          String         @unique @db.VarChar(15)
  password_hash   String         @db.VarChar(255)
  name            String         @db.VarChar(100)
  role            String         @db.VarChar(20)
  branch_id       Int?
  activity_logs   ActivityLog[]
  day_end_records DayEndRecord[]
  inventory_logs  InventoryLog[]
  created_orders  Order[]        @relation("OrderCreator")
  delivery_orders Order[]        @relation("OrderDeliveryStaff")
  branch          Branch?        @relation(fields: [branch_id], references: [id])

  @@map("staff_users")
}

model DayEndRecord {
  id            Int       @id @default(autoincrement())
  date          DateTime  @db.Date
  closed_by     Int
  closed_at     DateTime? @default(now())
  total_sales   Float?    @default(0.0)
  total_orders  Int?      @default(0)
  expected_cash Float?    @default(0.0)
  total_tips    Float?    @default(0.0)
  closer        User      @relation(fields: [closed_by], references: [id])

  @@map("day_end_records")
}

model Invoice {
  id                    Int            @id @default(autoincrement())
  order_id              Int
  invoice_number        String         @unique @db.VarChar(50)
  subtotal              Float
  discount              Float?         @default(0.0)
  gst_percent           Float?         @default(5.0)
  gst_amount            Float?         @default(0.0)
  round_off             Float?         @default(0.0)
  delivery_charge       Float?         @default(0.0)
  total                 Float
  payment_method        String?        @db.VarChar(20)
  custom_payment_method String?        @db.VarChar(50)
  payment_note          String?
  customer_paid         Float?         @default(0.0)
  change_returned       Float?         @default(0.0)
  tip_amount            Float?         @default(0.0)
  split_type            String?        @db.VarChar(20)
  split_metadata        String?
  coupon_code           String?        @db.VarChar(50)
  created_at            DateTime?      @default(now())
  credit_ledgers        CreditLedger[]
  order                 Order          @relation(fields: [order_id], references: [id])
  refunds               Refund[]

  @@map("invoices")
}

model CreditLedger {
  id              Int       @id @default(autoincrement())
  customer_name   String    @db.VarChar(100)
  customer_mobile String    @db.VarChar(15)
  invoice_id      Int
  amount          Float
  due_date        DateTime?
  status          String?   @default("outstanding") @db.VarChar(20)
  invoice         Invoice   @relation(fields: [invoice_id], references: [id])

  @@map("credit_ledger")
}

model Refund {
  id           Int       @id @default(autoincrement())
  invoice_id   Int
  amount       Float
  reason       String?   @db.VarChar(100)
  returned_via String?   @db.VarChar(20)
  note         String?
  status       String?   @default("pending") @db.VarChar(20)
  created_at   DateTime? @default(now())
  invoice      Invoice   @relation(fields: [invoice_id], references: [id])

  @@map("refunds")
}

model ActivityLog {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(255)
  details    String?
  created_at DateTime? @default(now())
  user       User?     @relation(fields: [user_id], references: [id])

  @@map("activity_log")
}

model Coupon {
  id               Int       @id @default(autoincrement())
  code             String    @unique @db.VarChar(50)
  discount_type    String    @db.VarChar(10)
  discount_value   Float
  min_order_amount Float?    @default(0.0)
  expiry_date      DateTime?
  max_usage_limit  Int?
  usage_count      Int?      @default(0)
  is_active        Boolean?  @default(true)

  @@map("coupons")
}

model CustomerProfile {
  mobile         String    @id @db.VarChar(15)
  name           String?   @db.VarChar(100)
  notes          String?
  loyalty_points Int?      @default(0)
  created_at     DateTime? @default(now())

  @@map("customers")
}

model WaiterCall {
  id         Int       @id @default(autoincrement())
  table_name String?   @db.VarChar(20)
  order_id   Int?
  status     String?   @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now())
  order      Order?    @relation(fields: [order_id], references: [id])

  @@map("waiter_calls")
}

model Feedback {
  id         Int       @id @default(autoincrement())
  order_id   Int
  rating     Int
  comment    String?
  created_at DateTime? @default(now())
  order      Order     @relation(fields: [order_id], references: [id])

  @@map("feedback")
}

model RawMaterial {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(100)
  unit                String         @db.VarChar(20)
  current_stock       Float?         @default(0.0)
  low_stock_threshold Float?         @default(10.0)
  created_at          DateTime?      @default(now())
  logs                InventoryLog[]

  @@map("raw_materials")
}

model InventoryLog {
  id              Int         @id @default(autoincrement())
  raw_material_id Int
  type            String      @db.VarChar(20)
  quantity        Float
  reason          String?     @db.VarChar(255)
  user_id         Int?
  created_at      DateTime?   @default(now())
  raw_material    RawMaterial @relation(fields: [raw_material_id], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [user_id], references: [id])

  @@map("inventory_logs")
}
